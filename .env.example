# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# MongoDB connection string
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/taskier"

# Unsplash (server-side only)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Public URL of the app, used for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Vercel Cron sends to /api/cron/* (any long random string)
CRON_SECRET=generate_a_long_random_string
